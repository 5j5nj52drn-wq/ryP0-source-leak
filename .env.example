# Public URL of the deployed consumer submission API. This value is safe to ship in the app.
EXPO_PUBLIC_REQUESTS_API_URL=https://your-project.expo.app

# Set this only in the API host's secret environment (never in the mobile app).
# Give the fine-grained GitHub token Issues: Read and write access to ry0-x/ry0-x.github.io.
GITHUB_REQUESTS_TOKEN=github_pat_replace_me

# Optional: permit a separately hosted web build to call the request API. Leave
# unset when the API and web app share a domain. Native iOS requests do not need it.
REQUESTS_ALLOWED_ORIGIN=https://your-project.expo.app

# Optional synchronous Telegram/R2 worker configuration. Developer Mode uses the
# protected GitHub Actions importer when this public API URL is not configured,
# so local and physical-iPhone builds do not need an environment file.
# EXPO_PUBLIC_IMPORT_API_URL=https://your-project.expo.app
# These two values belong only on that optional API host, never in the mobile app.
TELEGRAM_IMPORT_SERVICE_URL=https://your-telegram-r2-worker.example/import
TELEGRAM_IMPORT_SERVICE_TOKEN=replace_with_a_long_random_server_secret
