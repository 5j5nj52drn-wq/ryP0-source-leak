# Public URL of the deployed private control API. A URL is safe to ship in the
# app; credentials are not. This service receives consumer app requests and
# performs administrator-only imports with a GitHub App, not a mobile PAT.
EXPO_PUBLIC_CONTROL_API_URL=https://your-ryp0-control-api.example

# This is the only public backend configuration used by new builds. Do not add
# GitHub, Telegram, R2, or administrator credentials to an EXPO_PUBLIC_ value.
