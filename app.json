{
  "expo": {
    "name": "ryP0",
    "slug": "ryP0",
    "scheme": "ryp0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ry0.ryP0.admin",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "livecontainer"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.ry0.ryp0.admin"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow ryP0 to use Face ID to unlock Developer Mode."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ryP0 to use Face ID to unlock Developer Mode."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ryP0 to save icons to your photo library."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e42af62f-0f3a-4bdd-a32a-0a3faf6f477c"
      }
    }
  }
}
