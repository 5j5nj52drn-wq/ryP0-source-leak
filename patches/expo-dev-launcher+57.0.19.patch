+    # omitting the no-longer-used category implementation in prebuilt-Core builds.
+    if ENV['RCT_USE_PREBUILT_RNCORE'] == '1'
+      unsafe.source_files = 'ios/Unsafe/**/*.h'
+    else
+      unsafe.source_files = 'ios/Unsafe/**/*.{h,m,mm,swift,cpp}'
