+  let argumentsPtr: UnsafePointer<facebook.jsi.Value>
+  let resultPtr: UnsafeMutablePointer<facebook.jsi.Value>
+
+  init(
+    thisPtr: UnsafePointer<facebook.jsi.Value>,
+    argumentsPtr: UnsafePointer<facebook.jsi.Value>,
+    resultPtr: UnsafeMutablePointer<facebook.jsi.Value>
+  ) {
+    self.thisPtr = thisPtr
+    self.argumentsPtr = argumentsPtr
+    self.resultPtr = resultPtr
+  }
